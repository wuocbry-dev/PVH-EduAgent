NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Số lớp reverse proxy đứng trước API (vd. 1 khi sau nginx) để lấy IP thật của client; false = không tin X-Forwarded-For
TRUST_PROXY=false
# Kích thước tối đa body JSON/form (ảnh tải lên có giới hạn riêng 5 MB)
BODY_LIMIT=1mb
# Hạn mức mặc định mỗi tài khoản (hoặc IP nếu chưa đăng nhập): THROTTLE_LIMIT lượt / THROTTLE_TTL_SEC giây.
# Route nhạy cảm (đăng nhập, agent, liên hệ...) có hạn mức riêng chặt hơn.
THROTTLE_LIMIT=300
THROTTLE_TTL_SEC=60
# Chỉ để true khi chạy e2e. Production phải để false.
THROTTLE_DISABLED=false

# Xác thực (F10). Tạo bí mật: openssl rand -hex 32 (ít nhất 32 ký tự, không commit)
JWT_ACCESS_SECRET=
# true = cho phép chọn tài khoản qua header x-dev-user-email (chỉ có tác dụng khi NODE_ENV=development)
DEV_AUTH=false

# AI Agent – Claude Agent SDK (không commit file .env)
# Cách 1 – key Anthropic Console: điền ANTHROPIC_API_KEY, để trống AUTH_TOKEN và BASE_URL.
ANTHROPIC_API_KEY=
# Cách 2 – gateway bên thứ 3 (vd. https://1gw.gwai.cloud): điền token vào ANTHROPIC_AUTH_TOKEN
# và endpoint vào ANTHROPIC_BASE_URL; dùng tên model mà gateway hỗ trợ (vd. claude-opus-5).
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-opus-5-5
# Model nhỏ cho tác vụ phụ của Claude Code (vd. claude-haiku-4-5 với gateway). Bỏ trống = mặc định.
AGENT_SMALL_MODEL=
AGENT_API_TIMEOUT_MS=600000
AGENT_MAX_TURNS=8
AGENT_MAX_BUDGET_USD=0.5

# Bí mật chung với apps/web để làm mới cache trang công khai (ít nhất 16 ký tự, vd. openssl rand -hex 16)
REVALIDATE_SECRET=

# Thư mục lưu ảnh tải lên (F13), không commit
UPLOAD_DIR=uploads

# Hạ tầng (docker-compose.yml ở thư mục gốc)
DATABASE_URL=postgresql://pvh:pvh@localhost:5432/pvh_eduagent
REDIS_URL=redis://localhost:6379
# Tiền tố khóa BullMQ trong Redis (mặc định pvh)
BULLMQ_PREFIX=pvh

# Telegram bot (tạo bằng @BotFather, xem README). Bỏ trống token = tắt bot.
TELEGRAM_BOT_TOKEN=
# polling (dev, không cần URL public) | webhook (production) | off
TELEGRAM_MODE=polling
# Bắt buộc khi TELEGRAM_MODE=webhook (16–256 ký tự A-Z a-z 0-9 _ -), vd. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Tự gửi thông báo (nhắc hạn, báo cáo ngày, kết quả đăng bài) qua bot cho người đã liên kết; false = chỉ gửi khi gọi tường minh (e2e)
TELEGRAM_AUTO_NOTIFY=true
# URL public của webhook, vd. https://pvh.edu.vn/api/telegram/webhook (có thì API tự gọi setWebhook)
TELEGRAM_WEBHOOK_URL=
