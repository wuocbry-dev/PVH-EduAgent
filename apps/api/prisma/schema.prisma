// Lược đồ CSDL theo ERD (docs/diagrams/drawio/17-ERD.drawio).
// Tên model/field theo camelCase trong code, map sang snake_case trong PostgreSQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Phân quyền (RBAC) ─────────────────────────────

model Role {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  LOCKED
  // Tài khoản nhập hàng loạt, chưa kích hoạt (password_hash là giá trị không dùng được).
  PENDING
}

model User {
  id             BigInt     @id @default(autoincrement())
  // Học sinh có thể không có email (đăng nhập bằng mã học sinh); vẫn duy nhất khi có.
  email          String?    @unique @db.VarChar(150)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  fullName       String     @map("full_name") @db.VarChar(120)
  phone          String?    @db.VarChar(20)
  telegramChatId String?    @unique @map("telegram_chat_id") @db.VarChar(50)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  roles          UserRole[]
  authoredPosts  Post[]          @relation("PostAuthor")
  reviewedPosts  Post[]          @relation("PostReviewer")
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  Task[]          @relation("TaskAssignee")
  events         Event[]
  media          Media[]
  notifications  Notification[]
  agentActions   AgentAction[]
  auditLogs      AuditLog[]
  systemSettings SystemSetting[]
  refreshTokens  RefreshToken[]

  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  enrollments         ClassEnrollment[]
  homeroomClasses     SchoolClass[]        @relation("ClassHomeroom")
  activationCodes     ActivationCode[]     @relation("ActivationTarget")
  teachingAssignments TeachingAssignment[]

  timetableSlots      TimetableSlot[]
  unavailability      TeacherUnavailability[]
  createdTimetables   Timetable[]             @relation("TimetableCreator")
  publishedTimetables Timetable[]             @relation("TimetablePublisher")

  createdAssessments   Assessment[]      @relation("AssessmentCreator")
  publishedAssessments AssessmentClass[] @relation("AssessmentPublisher")
  scores               Score[]           @relation("ScoreStudent")
  enteredScores        Score[]           @relation("ScoreEnteredBy")
  scoreHistory         ScoreHistory[]    @relation("ScoreHistoryStudent")
  scoreChanges         ScoreHistory[]    @relation("ScoreHistoryChanger")
  scoreApprovals       ScoreHistory[]    @relation("ScoreHistoryApprover")

  scoreDeadlines        ScoreDeadline[]   @relation("ScoreDeadlineUpdater")
  scoreLocks            ScoreLock[]       @relation("ScoreLocker")
  adjustmentsAbout      ScoreAdjustment[] @relation("ScoreAdjustmentStudent")
  requestedAdjustments  ScoreAdjustment[] @relation("ScoreAdjustmentRequester")
  reviewedAdjustments   ScoreAdjustment[] @relation("ScoreAdjustmentReviewer")

  @@map("users")
}

// Ngoài ERD (thêm ở F10): refresh token đăng nhập, chỉ lưu bản băm SHA-256.
// Mỗi token dùng một lần: khi refresh thì thu hồi (revoked_at) và cấp token mới.
model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────────── Nội dung (CMS) ─────────────────────────────

model Category {
  id        BigInt     @id @default(autoincrement())
  parentId  BigInt?    @map("parent_id")
  name      String     @db.VarChar(120)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  posts     Post[]

  @@map("categories")
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PostSource {
  WEB
  TELEGRAM
}

model Post {
  id           BigInt     @id @default(autoincrement())
  categoryId   BigInt?    @map("category_id")
  authorId     BigInt     @map("author_id")
  reviewerId   BigInt?    @map("reviewer_id")
  title        String     @db.VarChar(255)
  slug         String     @unique @db.VarChar(255)
  summary      String?    @db.VarChar(500)
  content      String
  thumbnailUrl String?    @map("thumbnail_url") @db.VarChar(500)
  status       PostStatus @default(DRAFT)
  publishAt    DateTime?  @map("publish_at") @db.Timestamptz
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz
  rejectReason String?    @map("reject_reason")
  viewCount    Int        @default(0) @map("view_count")
  // Nơi bài được tạo; TELEGRAM = người dùng soạn qua bot (AI Agent).
  source       PostSource @default(WEB)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User      @relation("PostAuthor", fields: [authorId], references: [id])
  reviewer User?     @relation("PostReviewer", fields: [reviewerId], references: [id])
  media    Media[]

  // Scheduler quét bài SCHEDULED có publish_at đã đến hạn.
  @@index([status, publishAt])
  @@map("posts")
}

enum MediaStatus {
  PENDING
  READY
}

enum MediaKind {
  IMAGE
  VIDEO
}

model Media {
  id         BigInt      @id @default(autoincrement())
  postId     BigInt?     @map("post_id")
  uploadedBy BigInt      @map("uploaded_by")
  url        String      @db.VarChar(500)
  // Khoá object trong kho lưu trữ (R2: tên object; local: tên file trong uploads/). Sinh ngẫu nhiên, không dùng tên file người dùng.
  storageKey String      @unique @map("storage_key") @db.VarChar(120)
  status     MediaStatus @default(PENDING)
  kind       MediaKind   @default(IMAGE)
  mimeType   String      @map("mime_type") @db.VarChar(80)
  size       Int
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  post       Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploader   User        @relation(fields: [uploadedBy], references: [id])

  @@index([status, createdAt])
  @@map("media")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  createdBy BigInt   @map("created_by")
  title     String   @db.VarChar(255)
  location  String?  @db.VarChar(255)
  startAt   DateTime @map("start_at") @db.Timestamptz
  endAt     DateTime @map("end_at") @db.Timestamptz
  creator   User     @relation(fields: [createdBy], references: [id])

  @@index([startAt])
  @@map("events")
}

model AdmissionStat {
  id           BigInt   @id @default(autoincrement())
  schoolYear   String   @unique @map("school_year") @db.VarChar(9)
  quota        Int
  benchmarkNv1 Decimal? @map("benchmark_nv1") @db.Decimal(4, 2)
  benchmarkNv2 Decimal? @map("benchmark_nv2") @db.Decimal(4, 2)
  benchmarkNv3 Decimal? @map("benchmark_nv3") @db.Decimal(4, 2)
  note         String?

  @@map("admission_stats")
}

model Contact {
  id        BigInt   @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String?  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(200)
  message   String
  status    String   @default("NEW") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contacts")
}

// ───────────────────────────── Công việc & hạn chót ─────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  OVERDUE
}

model Task {
  id          BigInt       @id @default(autoincrement())
  createdBy   BigInt       @map("created_by")
  assigneeId  BigInt       @map("assignee_id")
  title       String       @db.VarChar(255)
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueAt       DateTime     @map("due_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz

  creator   User           @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee  User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reminders TaskReminder[]

  @@index([assigneeId, dueAt])
  @@index([status, dueAt])
  @@map("tasks")
}

model TaskReminder {
  id         BigInt   @id @default(autoincrement())
  taskId     BigInt   @map("task_id")
  remindType String   @map("remind_type") @db.VarChar(20)
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Mỗi mốc nhắc (BEFORE_DUE, OVERDUE) chỉ gửi một lần cho mỗi công việc (A06).
  @@unique([taskId, remindType])
  @@map("task_reminders")
}

// ───────────────────────────── Hệ thống, AI Agent, nhật ký ─────────────────────────────

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedBy BigInt?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updater   User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model Notification {
  id      BigInt    @id @default(autoincrement())
  userId  BigInt    @map("user_id")
  channel String    @db.VarChar(20)
  title   String    @db.VarChar(200)
  body    String
  sentAt  DateTime? @map("sent_at") @db.Timestamptz
  readAt  DateTime? @map("read_at") @db.Timestamptz
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum AgentActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  DONE
  FAILED
}

// Thao tác của agent chờ người dùng bấm Xác nhận/Huỷ trên Telegram (A08).
model AgentAction {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @map("user_id")
  toolName    String            @map("tool_name") @db.VarChar(80)
  args        Json
  status      AgentActionStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz
  confirmedAt DateTime?         @map("confirmed_at") @db.Timestamptz
  result      Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("agent_actions")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  channel    String   @db.VarChar(20)
  action     String   @db.VarChar(80)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   BigInt?  @map("target_id")
  payload    Json?
  ip         String?  @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Học vụ (bước 14) ─────────────────────────────
// Dữ liệu tối thiểu: không lưu thông tin gia đình, địa chỉ, CCCD, điểm số.
// Chỉ có đúng một năm học hiện hành: index duy nhất một phần `school_years_one_current` (xem migration).

model SchoolYear {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")

  semesters           Semester[]
  classes             SchoolClass[]
  enrollments         ClassEnrollment[]
  periodQuotas        SubjectPeriodQuota[]
  teachingAssignments TeachingAssignment[]

  @@map("school_years")
}

model Semester {
  id           BigInt   @id @default(autoincrement())
  schoolYearId BigInt   @map("school_year_id")
  number       Int
  name         String   @db.VarChar(40)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date

  schoolYear          SchoolYear           @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]

  timetables  Timetable[]
  assessments Assessment[]

  scoreDeadlines ScoreDeadline[]
  scoreLock      ScoreLock?

  @@unique([schoolYearId, number])
  @@map("semesters")
}

model Grade {
  id           BigInt               @id @default(autoincrement())
  level        Int                  @unique
  name         String               @db.VarChar(20)
  classes      SchoolClass[]
  periodQuotas SubjectPeriodQuota[]

  @@map("grades")
}

model Department {
  id       BigInt           @id @default(autoincrement())
  name     String           @unique @db.VarChar(100)
  subjects Subject[]
  teachers TeacherProfile[]

  @@map("departments")
}

enum GradingType {
  SCORE
  COMMENT
}

model Subject {
  id           BigInt      @id @default(autoincrement())
  code         String      @unique @db.VarChar(20)
  name         String      @db.VarChar(100)
  departmentId BigInt?     @map("department_id")
  gradingType  GradingType @default(SCORE) @map("grading_type")

  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  periodQuotas        SubjectPeriodQuota[]
  classQuotas         ClassPeriodQuota[]
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@map("subjects")
}

// Chỉ phòng bộ môn (Tin học, thí nghiệm, sân/nhà thể chất…), không quản lý từng phòng học thường.
model Room {
  id   BigInt  @id @default(autoincrement())
  name String  @unique @db.VarChar(100)
  kind String? @db.VarChar(50)

  timetableSlots TimetableSlot[]

  @@map("rooms")
}

// Model tên SchoolClass vì `Class` dễ trùng từ khoá; bảng vẫn là `classes`.
model SchoolClass {
  id                BigInt  @id @default(autoincrement())
  name              String  @db.VarChar(20)
  gradeId           BigInt  @map("grade_id")
  schoolYearId      BigInt  @map("school_year_id")
  subjectCombo      String? @map("subject_combo") @db.VarChar(100)
  homeroomTeacherId BigInt? @map("homeroom_teacher_id")

  grade               Grade                @relation(fields: [gradeId], references: [id])
  schoolYear          SchoolYear           @relation(fields: [schoolYearId], references: [id])
  homeroomTeacher     User?                @relation("ClassHomeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  enrollments         ClassEnrollment[]
  periodQuotas        ClassPeriodQuota[]
  teachingAssignments TeachingAssignment[]

  timetableSlots TimetableSlot[]
  // Lớp học buổi nào (thời khoá biểu): mặc định cả sáng lẫn chiều.
  sessions       ClassSessions   @default(BOTH)

  assessmentClasses AssessmentClass[]
  scores            Score[]
  scoreAdjustments  ScoreAdjustment[]

  @@unique([schoolYearId, name])
  @@index([homeroomTeacherId])
  @@map("classes")
}

model TeacherProfile {
  userId       BigInt  @id @map("user_id")
  teacherCode  String  @unique @map("teacher_code") @db.VarChar(20)
  departmentId BigInt? @map("department_id")
  // Định mức tiết/tuần riêng của giáo viên (giảm tiết cho chủ nhiệm, tổ trưởng…); rỗng = dùng mặc định chung (teaching.default_quota).
  weeklyQuota  Int?    @map("weekly_quota")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@map("teacher_profiles")
}

enum Gender {
  MALE
  FEMALE
}

model StudentProfile {
  userId      BigInt    @id @map("user_id")
  studentCode String    @unique @map("student_code") @db.VarChar(20)
  birthDate   DateTime? @map("birth_date") @db.Date
  gender      Gender?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// Một học sinh chỉ thuộc một lớp trong một năm học (unique student_id + school_year_id).
model ClassEnrollment {
  id           BigInt @id @default(autoincrement())
  studentId    BigInt @map("student_id")
  classId      BigInt @map("class_id")
  schoolYearId BigInt @map("school_year_id")

  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      SchoolClass @relation(fields: [classId], references: [id])
  schoolYear SchoolYear  @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, schoolYearId])
  @@index([classId])
  @@map("class_enrollments")
}

// Mã kích hoạt dùng một lần: chỉ lưu HMAC của mã; cấp mã mới thì mã cũ bị thu hồi.
model ActivationCode {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdBy BigInt?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation("ActivationTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_codes")
}

// ───────────────────────────── Phân công giảng dạy (bước 16) ─────────────────────────────
// Số liệu mẫu trong seed là MẪU theo GDPT 2018, cần đối chiếu với kế hoạch giáo dục của nhà trường.

// Số tiết/tuần của một môn theo khối và năm học (vd. Toán khối 10: 3 tiết).
model SubjectPeriodQuota {
  id             BigInt @id @default(autoincrement())
  schoolYearId   BigInt @map("school_year_id")
  gradeId        BigInt @map("grade_id")
  subjectId      BigInt @map("subject_id")
  periodsPerWeek Int    @map("periods_per_week")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  grade      Grade      @relation(fields: [gradeId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])

  @@unique([schoolYearId, gradeId, subjectId])
  @@map("subject_period_quotas")
}

// Ghi đè định mức môn cho một lớp cụ thể (lớp chuyên, tổ hợp khác).
model ClassPeriodQuota {
  id             BigInt @id @default(autoincrement())
  classId        BigInt @map("class_id")
  subjectId      BigInt @map("subject_id")
  periodsPerWeek Int    @map("periods_per_week")

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_period_quotas")
}

// Một lớp–môn–phạm vi chỉ có một giáo viên chính. semester_id rỗng = cả năm học. Ràng buộc duy nhất là hai index
// một phần (xem migration `teaching_assignments`): (lớp, môn) khi cả năm và (lớp, môn, học kỳ) khi theo học kỳ.
model TeachingAssignment {
  id             BigInt   @id @default(autoincrement())
  schoolYearId   BigInt   @map("school_year_id")
  semesterId     BigInt?  @map("semester_id")
  classId        BigInt   @map("class_id")
  subjectId      BigInt   @map("subject_id")
  teacherId      BigInt   @map("teacher_id")
  periodsPerWeek Int      @map("periods_per_week")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  schoolYear SchoolYear  @relation(fields: [schoolYearId], references: [id])
  semester   Semester?   @relation(fields: [semesterId], references: [id])
  class      SchoolClass @relation(fields: [classId], references: [id])
  subject    Subject     @relation(fields: [subjectId], references: [id])
  teacher    User        @relation(fields: [teacherId], references: [id])

  timetableSlots TimetableSlot[]

  @@index([teacherId])
  @@index([classId])
  @@map("teaching_assignments")
}

// ───────────────────────────── Thời khoá biểu (bước 17) ─────────────────────────────
// Chặn trùng ở CSDL (trong cùng một phiên bản): giáo viên, lớp, phòng không thể có hai tiết cùng (thứ, tiết).
// Các index duy nhất một phần, CHECK khoảng giá trị và ràng buộc "ngày hiệu lực" nằm trong migration `timetable`.

enum ClassSessions {
  MORNING
  AFTERNOON
  BOTH
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Một phiên bản thời khoá biểu của một học kỳ. Nhiều bản PUBLISHED có thể cùng tồn tại với ngày hiệu lực khác nhau:
// ngày D dùng bản có effective_date lớn nhất <= D; bản cũ chuyển ARCHIVED khi bản mới bắt đầu có hiệu lực.
model Timetable {
  id            BigInt          @id @default(autoincrement())
  semesterId    BigInt          @map("semester_id")
  name          String          @db.VarChar(120)
  status        TimetableStatus @default(DRAFT)
  effectiveDate DateTime?       @map("effective_date") @db.Date
  createdBy     BigInt          @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  publishedBy   BigInt?         @map("published_by")
  publishedAt   DateTime?       @map("published_at") @db.Timestamptz

  semester  Semester        @relation(fields: [semesterId], references: [id])
  creator   User            @relation("TimetableCreator", fields: [createdBy], references: [id])
  publisher User?           @relation("TimetablePublisher", fields: [publishedBy], references: [id])
  slots     TimetableSlot[]

  @@index([semesterId, status])
  @@map("timetables")
}

// day: 1 = thứ Hai ... 6 = thứ Bảy. teacher_id lặp lại từ phân công để đặt được ràng buộc duy nhất
// (đồng bộ khi phân công đổi giáo viên).
model TimetableSlot {
  id           BigInt   @id @default(autoincrement())
  timetableId  BigInt   @map("timetable_id")
  day          Int
  period       Int
  classId      BigInt   @map("class_id")
  assignmentId BigInt   @map("assignment_id")
  teacherId    BigInt   @map("teacher_id")
  roomId       BigInt?  @map("room_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  timetable  Timetable          @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  class      SchoolClass        @relation(fields: [classId], references: [id])
  assignment TeachingAssignment @relation(fields: [assignmentId], references: [id])
  teacher    User               @relation(fields: [teacherId], references: [id])
  room       Room?              @relation(fields: [roomId], references: [id])

  @@unique([timetableId, teacherId, day, period], map: "timetable_slots_teacher_unique")
  @@unique([timetableId, classId, day, period], map: "timetable_slots_class_unique")
  @@index([assignmentId])
  @@map("timetable_slots")
}

enum FixedPeriodKind {
  SCHOOL
  CLASS_MEETING
}

// Tiết cố định áp cho cả trường (grade_level rỗng) hoặc một khối: Chào cờ, Sinh hoạt lớp...
// CLASS_MEETING: giáo viên chủ nhiệm của lớp bận ở tiết này.
model FixedPeriod {
  id         BigInt          @id @default(autoincrement())
  name       String          @db.VarChar(80)
  kind       FixedPeriodKind @default(SCHOOL)
  day        Int
  period     Int
  gradeLevel Int?            @map("grade_level")

  @@map("fixed_periods")
}

// Tiết bận do giáo viên đăng ký: chỉ để BGH tham khảo (không chặn). Xếp đè lên thì cần xác nhận và ghi audit_logs.
model TeacherUnavailability {
  id        BigInt  @id @default(autoincrement())
  teacherId BigInt  @map("teacher_id")
  day       Int
  period    Int
  note      String? @db.VarChar(200)

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day, period])
  @@map("teacher_unavailability")
}

// ───────────────────────────── Đợt thi và điểm (bước 18) ─────────────────────────────
// Điểm là dữ liệu nhạy cảm nhất hệ thống: ADMIN, AI Agent, Telegram không đọc/ghi. Mọi thay đổi điểm ghi score_history
// (bảng chỉ thêm: trigger chặn UPDATE/DELETE). CHECK 0–10 và CHECK "có điểm ⇔ trạng thái GRADED" nằm trong migration.

enum AssessmentType {
  THUONG_XUYEN
  GIUA_KY
  CUOI_KY
}

enum AssessmentClassStatus {
  DRAFT
  PUBLISHED
}

enum ScoreStatus {
  GRADED
  ABSENT
  EXEMPT
}

// Đợt thi/kiểm tra có mã duy nhất (KT-2026-HK1-TOAN-10A1-003). Đợt thường xuyên do giáo viên tạo cho một lớp;
// giữa kỳ/cuối kỳ do BGH tạo cho nhiều lớp của một khối (grade_level).
model Assessment {
  id            BigInt         @id @default(autoincrement())
  code          String         @unique @db.VarChar(40)
  type          AssessmentType
  semesterId    BigInt         @map("semester_id")
  subjectId     BigInt         @map("subject_id")
  gradeLevel    Int?           @map("grade_level")
  testDate      DateTime       @map("test_date") @db.Date
  description   String?        @db.VarChar(500)
  entryDeadline DateTime?      @map("entry_deadline") @db.Timestamptz
  createdBy     BigInt         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  semester Semester          @relation(fields: [semesterId], references: [id])
  subject  Subject           @relation(fields: [subjectId], references: [id])
  creator  User              @relation("AssessmentCreator", fields: [createdBy], references: [id])
  classes     AssessmentClass[]
  scores      Score[]
  history     ScoreHistory[]
  adjustments ScoreAdjustment[]

  @@index([semesterId, subjectId])
  @@map("assessments")
}

// Lớp áp dụng đợt thi; trạng thái nháp/công bố theo từng lớp (giáo viên công bố cho lớp mình).
model AssessmentClass {
  id           BigInt                @id @default(autoincrement())
  assessmentId BigInt                @map("assessment_id")
  classId      BigInt                @map("class_id")
  status       AssessmentClassStatus @default(DRAFT)
  publishedAt  DateTime?             @map("published_at") @db.Timestamptz
  publishedBy  BigInt?               @map("published_by")

  assessment Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  class      SchoolClass @relation(fields: [classId], references: [id])
  publisher  User?       @relation("AssessmentPublisher", fields: [publishedBy], references: [id])

  @@unique([assessmentId, classId])
  @@index([classId])
  @@map("assessment_classes")
}

// Mỗi học sinh một điểm cho mỗi đợt. class_id: lớp của học sinh lúc nhập (học sinh phải thuộc một lớp của đợt).
model Score {
  id           BigInt      @id @default(autoincrement())
  assessmentId BigInt      @map("assessment_id")
  studentId    BigInt      @map("student_id")
  classId      BigInt      @map("class_id")
  value        Decimal?    @db.Decimal(4, 2)
  status       ScoreStatus @default(GRADED)
  note         String?     @db.VarChar(200)
  enteredBy    BigInt      @map("entered_by")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  assessment    Assessment  @relation(fields: [assessmentId], references: [id])
  student       User        @relation("ScoreStudent", fields: [studentId], references: [id])
  class         SchoolClass @relation(fields: [classId], references: [id])
  enteredByUser User        @relation("ScoreEnteredBy", fields: [enteredBy], references: [id])

  @@unique([assessmentId, studentId])
  @@index([classId])
  @@map("scores")
}

// Lịch sử mọi lần tạo/sửa/xoá điểm (giá trị điểm CHỈ nằm ở đây và ở scores, không bao giờ trong audit_logs).
model ScoreHistory {
  id           BigInt       @id @default(autoincrement())
  assessmentId BigInt       @map("assessment_id")
  studentId    BigInt       @map("student_id")
  action       String       @db.VarChar(10) // CREATE | UPDATE | DELETE
  oldValue     Decimal?     @map("old_value") @db.Decimal(4, 2)
  newValue     Decimal?     @map("new_value") @db.Decimal(4, 2)
  oldStatus    ScoreStatus? @map("old_status")
  newStatus    ScoreStatus? @map("new_status")
  note         String?      @db.VarChar(200)
  reason       String?      @db.VarChar(300)
  source       String       @db.VarChar(10) // GRID | EXCEL | EXEMPT | ADJUST (điều chỉnh sau hạn, bước 19)
  changedBy    BigInt       @map("changed_by")
  // Điều chỉnh sau hạn: changed_by là giáo viên đề nghị, approved_by là người BGH duyệt.
  approvedBy   BigInt?      @map("approved_by")
  changedAt    DateTime     @default(now()) @map("changed_at") @db.Timestamptz

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    User       @relation("ScoreHistoryStudent", fields: [studentId], references: [id])
  changer    User       @relation("ScoreHistoryChanger", fields: [changedBy], references: [id])
  approver   User?      @relation("ScoreHistoryApprover", fields: [approvedBy], references: [id])

  @@index([assessmentId, studentId])
  @@map("score_history")
}

// ───────────────────────────── Hạn nhập, khoá sổ, điều chỉnh điểm (bước 19) ─────────────────────────────

// Hạn nhập điểm chung theo học kỳ và loại đợt. Hạn riêng của đợt (assessments.entry_deadline) được ưu tiên hơn.
model ScoreDeadline {
  id         BigInt         @id @default(autoincrement())
  semesterId BigInt         @map("semester_id")
  type       AssessmentType
  deadline   DateTime       @db.Timestamptz
  updatedBy  BigInt         @map("updated_by")
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  updater  User     @relation("ScoreDeadlineUpdater", fields: [updatedBy], references: [id])

  @@unique([semesterId, type])
  @@map("score_deadlines")
}

// Khoá sổ thủ công cả học kỳ: có dòng = đã khoá, mọi điểm của học kỳ chỉ sửa được qua điều chỉnh có BGH duyệt.
model ScoreLock {
  semesterId BigInt   @id @map("semester_id")
  reason     String?  @db.VarChar(300)
  lockedBy   BigInt   @map("locked_by")
  lockedAt   DateTime @default(now()) @map("locked_at") @db.Timestamptz

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  locker   User     @relation("ScoreLocker", fields: [lockedBy], references: [id])

  @@map("score_locks")
}

enum ScoreAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Đề nghị điều chỉnh một điểm đã khoá (quá hạn hoặc khoá sổ). old_* là ảnh chụp lúc gửi: khi duyệt mà điểm hiện tại
// đã khác thì từ chối áp dụng. new_status rỗng = xoá điểm. Mỗi học sinh–đợt chỉ một đề nghị đang chờ (index một phần).
model ScoreAdjustment {
  id           BigInt                @id @default(autoincrement())
  assessmentId BigInt                @map("assessment_id")
  studentId    BigInt                @map("student_id")
  classId      BigInt                @map("class_id")
  oldValue     Decimal?              @map("old_value") @db.Decimal(4, 2)
  oldStatus    ScoreStatus?          @map("old_status")
  newValue     Decimal?              @map("new_value") @db.Decimal(4, 2)
  newStatus    ScoreStatus?          @map("new_status")
  newNote      String?               @map("new_note") @db.VarChar(200)
  reason       String                @db.VarChar(300)
  status       ScoreAdjustmentStatus @default(PENDING)
  requestedBy  BigInt                @map("requested_by")
  requestedAt  DateTime              @default(now()) @map("requested_at") @db.Timestamptz
  reviewedBy   BigInt?               @map("reviewed_by")
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz
  reviewNote   String?               @map("review_note") @db.VarChar(300)

  assessment Assessment  @relation(fields: [assessmentId], references: [id])
  student    User        @relation("ScoreAdjustmentStudent", fields: [studentId], references: [id])
  class      SchoolClass @relation(fields: [classId], references: [id])
  requester  User        @relation("ScoreAdjustmentRequester", fields: [requestedBy], references: [id])
  reviewer   User?       @relation("ScoreAdjustmentReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([assessmentId, studentId])
  @@map("score_adjustments")
}
