# URL của NestJS API (apps/api), dùng cho cả server và trình duyệt
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# true = hiện ô chọn vai trò ở trang Trợ lý AI (cần API chạy dev với DEV_AUTH=true)
NEXT_PUBLIC_DEV_AUTH=false

# Địa chỉ công khai của website (metadataBase, sitemap.xml, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bí mật chung với apps/api (REVALIDATE_SECRET) để API báo web làm mới cache khi đăng/gỡ bài.
# Chỉ dùng phía server, không có tiền tố NEXT_PUBLIC_. Bỏ trống = route /api/revalidate từ chối mọi yêu cầu.
REVALIDATE_SECRET=
