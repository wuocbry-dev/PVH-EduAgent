        </mxCell>
        <mxCell id="stm-4" value="&lt;b&gt;Nháp&lt;/b&gt; (DRAFT)&lt;hr&gt;do / chỉnh sửa nội dung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="120" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stm-5" value="&lt;b&gt;Chờ duyệt&lt;/b&gt; (PENDING_REVIEW)&lt;hr&gt;entry / thông báo người duyệt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stm-6" value="&lt;b&gt;Đã lên lịch&lt;/b&gt; (SCHEDULED)&lt;hr&gt;entry / tạo job BullMQ&lt;br&gt;exit / xoá job" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stm-7" value="&lt;b&gt;Bị từ chối&lt;/b&gt; (REJECTED)&lt;hr&gt;entry / gửi lý do cho tác giả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
