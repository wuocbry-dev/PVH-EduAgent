        </mxCell>
        <mxCell id="stm-8" value="&lt;b&gt;Đã đăng&lt;/b&gt; (PUBLISHED)&lt;hr&gt;entry / revalidate cache,&lt;br&gt;gửi thông báo Telegram" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
