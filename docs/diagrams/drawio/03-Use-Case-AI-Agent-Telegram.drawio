        </mxCell>
        <mxCell id="uc2-53" value="&lt;b&gt;Nguyên tắc&lt;/b&gt;&lt;br&gt;Agent không có quyền riêng: chỉ thực thi trong phạm vi quyền của người dùng đã liên kết. Mọi thao tác ghi Audit Log (kênh TELEGRAM / SCHEDULER)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
